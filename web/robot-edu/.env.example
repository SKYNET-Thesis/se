# Browser-safe Supabase values only. Never add DATABASE_URL or service-role keys.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>
VITE_API_BASE_URL=http://localhost:3001/api/v1
# Local mock Digital Twin only. On remote hosts, configure an explicit protected WS URL.
VITE_DIGITAL_TWIN_WS_URL=ws://127.0.0.1:8767/ws/twin
