#!/bin/bash
set -euo pipefail
dnf install -y docker nginx python3 jq
systemctl enable --now docker
cat > /etc/nginx/conf.d/vista-api.conf <<'NGINX'
server {
  listen 80 default_server;
  server_name _;
  location /api/v1/ {
    proxy_pass http://127.0.0.1:3000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_read_timeout 30s;
    client_max_body_size 1m;
  }
  location / { return 404; }
}
NGINX
rm -f /etc/nginx/conf.d/default.conf
systemctl enable --now nginx
mkdir -p /opt/vista
cat > /usr/local/bin/vista-deploy-api <<'DEPLOY'
${deploy_script}
DEPLOY
chmod 700 /usr/local/bin/vista-deploy-api
cat > /usr/local/bin/vista-rollback-api <<'ROLLBACK'
#!/bin/bash
set -euo pipefail
IMAGE="$(cat /opt/vista/previous-image)"
exec /usr/local/bin/vista-deploy-api "$IMAGE"
ROLLBACK
chmod 700 /usr/local/bin/vista-rollback-api
cat > /etc/vista-deploy.conf <<'CONF'
AWS_REGION=${aws_region}
SECRET_ID=${secret_id}
LOG_GROUP=${log_group}
CONF
chmod 600 /etc/vista-deploy.conf
