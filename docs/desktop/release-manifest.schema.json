{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vista-desktop-release-manifest",
  "title": "VISTA Desktop release manifest",
  "description": "Generated by CI only from artifacts that were built, installed and smoke-tested. Consumers must treat anything not listed here, or failing validation, as unavailable and must never construct download URLs.",
  "type": "object",
  "required": ["schemaVersion", "channel", "version", "publishedAt", "builtFromCommit", "platforms"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "channel": { "enum": ["stable", "beta"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "builtFromCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "buildRunUrl": { "type": "string", "format": "uri" },
    "minimumSupportedVersion": { "type": "string" },
    "revoked": { "type": "array", "items": { "type": "string" } },
    "platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "arch", "format", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["windows", "macos", "linux"] },
          "arch": { "enum": ["x64", "arm64", "universal"] },
          "format": { "enum": ["exe", "dmg", "zip", "deb"] },
          "status": { "enum": ["available", "unavailable"] },
          "filename": { "type": "string" },
          "url": { "type": "string", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "sizeBytes": { "type": "integer", "minimum": 1 },
          "minimumOs": { "type": "string" },
          "signature": { "type": "object", "required": ["type", "verified"], "properties": { "type": { "enum": ["authenticode", "apple-notarized", "gpg-detached"] }, "verified": { "type": "boolean" } } },
          "verification": { "type": "object", "required": ["smokeTestPassed"], "properties": { "smokeTestPassed": { "type": "boolean" } } }
        },
        "allOf": [
          { "if": { "properties": { "status": { "const": "available" } } },
            "then": { "required": ["filename", "url", "sha256", "sizeBytes", "signature", "verification"], "properties": { "verification": { "properties": { "smokeTestPassed": { "const": true } } }, "signature": { "properties": { "verified": { "const": true } } } } } }
        ]
      }
    }
  }
}
