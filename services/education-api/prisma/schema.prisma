generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ai_models {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  description           String?
  owner_type            String
  owner_organization_id String?             @db.Uuid
  owner_user_id         String?             @db.Uuid
  visibility            String              @default("private")
  status                String              @default("active")
  created_at            DateTime            @default(now()) @db.Timestamptz(6)
  updated_at            DateTime            @default(now()) @db.Timestamptz(6)
  organizations         organizations?      @relation(fields: [owner_organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                 users?              @relation(fields: [owner_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  model_checkpoints     model_checkpoints[]
  org_entitlements      org_entitlements[]
}

model api_keys {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  name         String?
  key_hash     String    @unique
  key_prefix   String?
  scopes       String[]  @default([])
  expires_at   DateTime? @db.Timestamptz(6)
  revoked_at   DateTime? @db.Timestamptz(6)
  last_used_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model app_installations {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String             @db.Uuid
  license_id          String             @db.Uuid
  machine_fingerprint String
  os                  String?
  app_version         String?
  first_seen_at       DateTime           @default(now()) @db.Timestamptz(6)
  last_seen_at        DateTime?          @db.Timestamptz(6)
  revoked_at          DateTime?          @db.Timestamptz(6)
  licenses            licenses           @relation(fields: [license_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users               users              @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  control_sessions    control_sessions[]
  port_assignments    port_assignments[]

  @@unique([license_id, machine_fingerprint])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model arms {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  robot_id             String                 @db.Uuid
  code                 String
  role                 String
  side                 String
  device_identity      String?
  model_name           String                 @default("SO-101")
  serial_number        String?
  status               String                 @default("disconnected")
  metadata             Json                   @default("{}")
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  robots               robots                 @relation(fields: [robot_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  calibration_profiles calibration_profiles[]
  port_assignments     port_assignments[]
  safety_events        safety_events[]
  session_arms         session_arms[]

  @@unique([robot_id, code])
  @@unique([robot_id, role, side])
}

model audit_logs {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_user_id   String?        @db.Uuid
  organization_id String?        @db.Uuid
  action          String
  target_type     String?
  target_id       String?        @db.Uuid
  ip_address      String?        @db.Inet
  details         Json           @default("{}")
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  users           users?         @relation(fields: [actor_user_id], references: [id], onUpdate: NoAction)
  organizations   organizations? @relation(fields: [organization_id], references: [id], onUpdate: NoAction)

  @@index([actor_user_id, created_at(sort: Desc)], map: "ix_audit_logs_actor_time")
  @@index([organization_id, created_at(sort: Desc)], map: "ix_audit_logs_org_time")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model auth_tokens {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  purpose    String
  token_hash String    @unique
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, purpose], map: "ix_auth_tokens_user")
}

model benchmark_tasks {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                   String                   @unique
  name                   String
  object_type            String
  target_container       String
  instruction_template   String?
  pass_criterion         String
  active                 Boolean                  @default(true)
  metadata               Json                     @default("{}")
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  demonstration_episodes demonstration_episodes[]
  evaluation_runs        evaluation_runs[]
  simulation_scenarios   simulation_scenarios[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model calibration_profiles {
  id                           String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  arm_id                       String                         @db.Uuid
  version                      Int
  calibration_values           Json
  status                       String                         @default("valid")
  calibrated_by                String?                        @db.Uuid
  calibrated_at                DateTime                       @default(now()) @db.Timestamptz(6)
  created_at                   DateTime                       @default(now()) @db.Timestamptz(6)
  notes                        String?
  arms                         arms                           @relation(fields: [arm_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                        users?                         @relation(fields: [calibrated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  readiness_check_calibrations readiness_check_calibrations[]

  @@unique([arm_id, version])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model control_modes {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String             @unique
  description      String?
  control_sessions control_sessions[]
  org_entitlements org_entitlements[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model control_sessions {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id         String                   @db.Uuid
  membership_id           String                   @db.Uuid
  robot_id                String                   @db.Uuid
  mode_id                 String                   @db.Uuid
  safety_profile_id       String                   @db.Uuid
  safety_profile_snapshot Json                     @default("{}")
  installation_id         String?                  @db.Uuid
  readiness_check_id      String?                  @db.Uuid
  state                   String                   @default("created")
  started_at              DateTime?                @db.Timestamptz(6)
  ended_at                DateTime?                @db.Timestamptz(6)
  end_reason              String?
  stop_reason             String?
  summary                 Json                     @default("{}")
  log_file_uri            String?
  metadata                Json                     @default("{}")
  created_at              DateTime                 @default(now()) @db.Timestamptz(6)
  model_checkpoint_id     String?                  @db.Uuid
  app_installations       app_installations?       @relation(fields: [installation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  memberships             memberships              @relation(fields: [membership_id, organization_id], references: [id, organization_id], onDelete: NoAction, onUpdate: NoAction)
  control_modes           control_modes            @relation(fields: [mode_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  model_checkpoints       model_checkpoints?       @relation(fields: [model_checkpoint_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  readiness_checks        readiness_checks?        @relation(fields: [readiness_check_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  robots                  robots                   @relation(fields: [robot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  safety_profiles         safety_profiles          @relation(fields: [safety_profile_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  demonstration_episodes  demonstration_episodes[]
  evaluation_runs         evaluation_runs[]
  learning_experiments    learning_experiments[]
  safety_events           safety_events[]
  session_arms            session_arms[]

  @@index([membership_id, created_at(sort: Desc)], map: "ix_control_sessions_member")
  @@index([organization_id, created_at(sort: Desc)], map: "ix_control_sessions_org")
  @@index([state, created_at(sort: Desc)], map: "ix_control_sessions_state_created")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model dataset_episodes {
  dataset_version_id       String                 @db.Uuid
  demonstration_episode_id String                 @db.Uuid
  split                    String
  dataset_versions         dataset_versions       @relation(fields: [dataset_version_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  demonstration_episodes   demonstration_episodes @relation(fields: [demonstration_episode_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([dataset_version_id, demonstration_episode_id])
  @@index([dataset_version_id, split], map: "ix_dataset_episodes_split")
}

model dataset_versions {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id      String?            @db.Uuid
  created_by           String?            @db.Uuid
  name                 String
  version              String
  split_definition     Json               @default("{}")
  huggingface_repo     String?
  huggingface_revision String?
  provenance           Json               @default("{}")
  is_frozen            Boolean            @default(false)
  created_at           DateTime           @default(now()) @db.Timestamptz(6)
  dataset_episodes     dataset_episodes[]
  users                users?             @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizations        organizations?     @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  training_runs        training_runs[]

  @@unique([name, version])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model demo_bookings {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_id           String    @db.Uuid
  scheduled_at      DateTime? @db.Timestamptz(6)
  format            String    @default("online")
  status            String    @default("pending")
  assigned_admin_id String?   @db.Uuid
  notes             String?
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  users             users?    @relation(fields: [assigned_admin_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  leads             leads     @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status, scheduled_at], map: "ix_demo_bookings_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model demonstration_episodes {
  id                                 String                               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id                    String?                              @db.Uuid
  recorded_by                        String?                              @db.Uuid
  benchmark_task_id                  String                               @db.Uuid
  observation_configuration_id       String?                              @db.Uuid
  control_session_id                 String?                              @db.Uuid
  simulation_scenario_id             String?                              @db.Uuid
  source                             String
  instruction                        String
  outcome                            String
  started_at                         DateTime                             @default(now()) @db.Timestamptz(6)
  ended_at                           DateTime?                            @db.Timestamptz(6)
  frame_count                        Int?
  storage_uri                        String?
  checksum                           String?
  provenance                         Json                                 @default("{}")
  metrics                            Json                                 @default("{}")
  created_at                         DateTime                             @default(now()) @db.Timestamptz(6)
  dataset_episodes                   dataset_episodes[]
  benchmark_tasks                    benchmark_tasks                      @relation(fields: [benchmark_task_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  control_sessions                   control_sessions?                    @relation(fields: [control_session_id], references: [id], onUpdate: NoAction)
  observation_configurations         observation_configurations?          @relation(fields: [observation_configuration_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizations                      organizations?                       @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                              users?                               @relation(fields: [recorded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  simulation_scenarios               simulation_scenarios?                @relation(fields: [simulation_scenario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  learning_demonstration_annotations learning_demonstration_annotations[]
  learning_demonstration_segments    learning_demonstration_segments[]
  learning_experiments               learning_experiments[]

  @@index([benchmark_task_id, outcome, created_at(sort: Desc)], map: "ix_demonstration_episodes_task_outcome")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model evaluation_runs {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  model_checkpoint_id    String                 @db.Uuid
  benchmark_task_id      String                 @db.Uuid
  simulation_scenario_id String?                @db.Uuid
  control_session_id     String?                @db.Uuid
  requested_by           String?                @db.Uuid
  target_mode            String
  status                 String                 @default("queued")
  outcome                String?
  trial_count            Int                    @default(0)
  success_count          Int                    @default(0)
  metrics                Json                   @default("{}")
  started_at             DateTime?              @db.Timestamptz(6)
  ended_at               DateTime?              @db.Timestamptz(6)
  created_at             DateTime               @default(now()) @db.Timestamptz(6)
  benchmark_tasks        benchmark_tasks        @relation(fields: [benchmark_task_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  control_sessions       control_sessions?      @relation(fields: [control_session_id], references: [id], onUpdate: NoAction)
  model_checkpoints      model_checkpoints      @relation(fields: [model_checkpoint_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                  users?                 @relation(fields: [requested_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  simulation_scenarios   simulation_scenarios?  @relation(fields: [simulation_scenario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  learning_experiments   learning_experiments[]

  @@index([model_checkpoint_id, created_at(sort: Desc)], map: "ix_evaluation_runs_checkpoint")
  @@index([benchmark_task_id, target_mode, created_at(sort: Desc)], map: "ix_evaluation_runs_task_mode")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model leads {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name         String
  email             String
  phone             String?
  organization_name String?
  lead_type         String
  segment_interest  String?
  use_case          String?
  message           String?
  source            String?
  status            String          @default("new")
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  demo_bookings     demo_bookings[]
  organizations     organizations[]

  @@index([status, created_at(sort: Desc)], map: "ix_leads_status_created")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model licenses {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String              @db.Uuid
  robot_id          String?             @db.Uuid
  license_key_hash  String              @unique
  key_prefix        String?
  plan              String
  max_installations Int                 @default(1)
  status            String              @default("active")
  issued_at         DateTime            @default(now()) @db.Timestamptz(6)
  expires_at        DateTime?           @db.Timestamptz(6)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  app_installations app_installations[]
  organizations     organizations       @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  robots            robots?             @relation(fields: [robot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model memberships {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                    String                       @db.Uuid
  organization_id            String                       @db.Uuid
  role_id                    String                       @db.Uuid
  safety_profile_id          String?                      @db.Uuid
  status                     String                       @default("active")
  starts_at                  DateTime                     @default(now()) @db.Timestamptz(6)
  ends_at                    DateTime?                    @db.Timestamptz(6)
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  control_sessions           control_sessions[]
  learning_classroom_members learning_classroom_members[]
  organizations              organizations                @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roles                      roles                        @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  safety_profiles            safety_profiles?             @relation(fields: [safety_profile_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                      users                        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_assignments           user_assignments[]

  @@unique([id, organization_id])
  @@unique([user_id, organization_id])
  @@index([organization_id, status], map: "ix_memberships_org")
}

