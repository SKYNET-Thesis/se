  status            String             @default("active")
  notes             String?
  arms              arms               @relation(fields: [arm_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  app_installations app_installations? @relation(fields: [installation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model readiness_check_calibrations {
  readiness_check_id     String               @db.Uuid
  calibration_profile_id String               @db.Uuid
  calibration_profiles   calibration_profiles @relation(fields: [calibration_profile_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  readiness_checks       readiness_checks     @relation(fields: [readiness_check_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([readiness_check_id, calibration_profile_id])
