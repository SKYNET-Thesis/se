{
  "name": "@vista/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed:demo-identities": "npm run build && node --env-file=.env dist/scripts/seed-demo-identities.js",
    "seed:demo-delivery": "npm run build && node --env-file=.env dist/scripts/seed-demo-delivery.js",
    "seed:demo-school-admin": "npm run build && node --env-file=.env dist/scripts/seed-demo-school-admin.js",
    "seed:wf01-demo-robot": "npm run build && node --env-file=.env dist/scripts/seed-wf01-demo-robot.js",
    "test": "jest --runInBand",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "dev": "nest start --watch"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@prisma/client": "^5.21.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jose": "5.10.0",
    "mqtt": "^5.10.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "prisma": "^5.21.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9.2"
  }
}
