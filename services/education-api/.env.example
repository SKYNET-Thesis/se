NODE_ENV=development
# Docker Compose publishes this internal port at http://localhost:3001.
PORT=3000
WEB_ORIGIN=http://localhost:5173
# Set to the trusted proxy hop count in production when TLS terminates upstream.
TRUST_PROXY=

# Supabase PostgreSQL connection URL. The existing database is the source of truth.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=5&connect_timeout=10"

# Private WF-03 R1 mapping. Keys are authoritative Robot DB UUIDs. Loopback URLs only.
VISTA_ROBOT_RUNTIME_MAP='{}'
VISTA_RUNTIME_TOKEN=

# Public Supabase project settings for JWT verification. Never put a service-role key here.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
# Production only: inject through AWS Secrets Manager, never into the web build.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_INVITE_REDIRECT_URL=http://localhost:5173
ROBOT_PROGRAM_MAX_STEPS=1000
ROBOT_PROGRAM_MAX_BYTES=1048576
HTTP_BODY_LIMIT_BYTES=1048576
SUPABASE_ANON_KEY=<public-anon-key>
# Server-only. Never expose this key to the browser or include it in logs.
SUPABASE_SERVICE_ROLE_KEY=<server-service-role-key>

# Robot runtime message broker.
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883

# Allow-listed, read-only CHECKIK runtime adapter. Leave unset when no runtime is configured.
ROBOT_RUNTIME_BASE_URL=http://127.0.0.1:8000
ROBOT_RUNTIME_TIMEOUT_MS=2500
# HMAC secret shared only with the Digital Twin verifier. Required to issue
# short-lived browser viewer scopes; inject from deployment secret management.
# DIGITAL_TWIN_SCOPE_SECRET=
