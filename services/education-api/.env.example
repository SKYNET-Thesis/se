NODE_ENV=development
# Docker Compose publishes this internal port at http://localhost:3001.
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Supabase PostgreSQL connection URL. The existing database is the source of truth.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Private WF-03 R1 mapping. Keys are authoritative Robot DB UUIDs. Loopback URLs only.
VISTA_ROBOT_RUNTIME_MAP='{}'
VISTA_RUNTIME_TOKEN=

# Public Supabase project settings for JWT verification. Never put a service-role key here.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# Robot runtime message broker.
MQTT_HOST=localhost
MQTT_PORT=1883

# Allow-listed, read-only CHECKIK runtime adapter. Leave unset when no runtime is configured.
ROBOT_RUNTIME_BASE_URL=http://127.0.0.1:8000
ROBOT_RUNTIME_TIMEOUT_MS=2500
