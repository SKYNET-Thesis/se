# Offline simulation only. The app has no hardware adapter or command endpoint.
VISTA_TWIN_MOCK_RATE_HZ=30
# Optional sequence numbers for a demo: disconnect at 60, reconnect at 120.
# VISTA_TWIN_MOCK_DISCONNECT_AT=60
# VISTA_TWIN_MOCK_RECONNECT_AT=120

# Physical telemetry stays disabled unless all four settings are provided.
# These values identify the existing LeLab worker that already owns the follower.
# Never put a serial port, LeRobot configuration or hardware credential here.
# VISTA_TWIN_PHYSICAL_OWNER_ID=lelab-teleop-left
# VISTA_TWIN_PHYSICAL_ORGANIZATION_ID=<organization-id>
# VISTA_TWIN_PHYSICAL_ROBOT_ID=so101-left
# VISTA_TWIN_AUTH_SECRET=<private-shared-scope-signing-secret>
