model permissions {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String             @unique
  description      String?
  role_permissions role_permissions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model port_assignments {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  arm_id            String             @db.Uuid
  installation_id   String?            @db.Uuid
  port_path         String
  device_identity   String?
  assigned_at       DateTime           @default(now()) @db.Timestamptz(6)
  released_at       DateTime?          @db.Timestamptz(6)
  status            String             @default("active")
  notes             String?
  arms              arms               @relation(fields: [arm_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  app_installations app_installations? @relation(fields: [installation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model readiness_check_calibrations {
  readiness_check_id     String               @db.Uuid
  calibration_profile_id String               @db.Uuid
  calibration_profiles   calibration_profiles @relation(fields: [calibration_profile_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  readiness_checks       readiness_checks     @relation(fields: [readiness_check_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([readiness_check_id, calibration_profile_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model readiness_checks {
  id                           String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  robot_id                     String                         @db.Uuid
  result                       String
  checks                       Json                           @default("{}")
  performed_at                 DateTime                       @default(now()) @db.Timestamptz(6)
  performed_by                 String?                        @db.Uuid
  failure_reason               String?
  created_at                   DateTime                       @default(now()) @db.Timestamptz(6)
  control_sessions             control_sessions[]
